# Copy to .env and fill in. Never commit .env.

# Bodhan keys, one per model (console.bodhan.ai). Leave any of them empty to fall back to BODHAN_API_KEY.
BODHAN_TRANSLATE_KEY=<your Indic-Translate key>
BODHAN_SPEAK_KEY=<your Indic-Speak key>
BODHAN_TRANSCRIBE_KEY=<your Indic-Transcribe key>
# Cookbook convention: a single Bodhan key used when a per-model key above is empty.
BODHAN_API_KEY=<optional single Bodhan key>
BODHAN_BASE_URL=https://api.bodhan.ai

# Judge LLM: any OpenAI-compatible chat endpoint (tested with OpenRouter).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=<provider/model slug, e.g. from openrouter.ai/models>
LLM_API_KEY=<your LLM key>
